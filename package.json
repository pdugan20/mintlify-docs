{
  "name": "mintlify-docs",
  "version": "0.2.2",
  "private": true,
  "description": "Dev tooling for the mintlify-docs Claude Code plugin. The plugin itself is pure-skill; nothing in this package ships to users.",
  "license": "MIT",
  "scripts": {
    "lint": "npm run lint:claude && npm run lint:md",
    "lint:claude": "claudelint check-all",
    "lint:md": "markdownlint-cli2",
    "validate:plugin": "claude plugin validate . --strict",
    "sync:version": "node scripts/sync-plugin-version.js",
    "package:plugin": "bash scripts/package-plugin.sh",
    "release": "release-it"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.1",
    "claude-code-lint": "^0.5.0",
    "markdownlint-cli2": "^0.22.1",
    "release-it": "^20.2.0"
  }
}
